{
  "expo": {
    "name": "Propenu",
    "slug": "Propenu",
    "scheme": "propenu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splashIcon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.propenu.app",
      "icon": "./assets/icon.png",
      "associatedDomains": [
        "applinks:propenu.com",
        "applinks:www.propenu.com",
        "applinks:propenu.in",
        "applinks:www.propenu.in"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
         "NSPhotoLibraryUsageDescription": "Propenu needs access to your photo library so you can select and upload property images while creating or editing listings and updating your profile.",
        "NSPhotoLibraryAddUsageDescription": "Propenu needs permission to save downloaded property images to your photo library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.propenu.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "propenu.com",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "www.propenu.com",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "propenu.in",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "www.propenu.in",
              "pathPrefix": "/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Propenu to access your photos",
          "cameraPermission": "Allow Propenu to access your camera",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "696adb46-ad4c-40a8-8641-21509282ee12"
      }
    }
  }
}
